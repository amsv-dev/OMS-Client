# Runtime credentials are minted on each install (fresh Vault, AppRole, console token).
# Do not commit them. Safe to track: docs, *.example templates, and .gitkeep placeholders.
compose/.env

compose/secrets/**
!compose/secrets/**/
!compose/secrets/**/.gitkeep
!compose/secrets/**/*.example
!compose/secrets/vault/README.md

# oms-sync: do not publish compose/secrets runtime material
# Allowlist: README.md, *.example, .gitkeep. Managed by OMSv2 deploy-client.
compose/secrets/**
!compose/secrets/**/
!compose/secrets/README.md
!compose/secrets/*.example
!compose/secrets/.gitkeep
!compose/secrets/**/README.md
!compose/secrets/**/*.example
!compose/secrets/**/.gitkeep
