# =============================================================================
# OMS CLIENT - Environment Variables Template
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Replace all <CHANGE_ME> and <CLIENT_NAME> values
# 3. Match INFLUXDB_CENTRAL_TOKEN with Central VM token
# 4. NEVER commit the actual .env file to Git
# =============================================================================

# =============================================================================
# RUNTIME IDENTITY
# =============================================================================

TENANT_ID=<TENANT_ID>    # Issued by OMS Central onboarding
ASSET_ID=<ASSET_ID>      # Issued by OMS Central onboarding bundle
SITE_CODE=<SITE_CODE>    # Optional override. Default = ASSET_ID
OBS_ENVIRONMENT=prod     # dev | pilot | prod
OBSERVABILITY_MODE=centralized-runtime
LOGICAL_ASSETS_SOFT_LIMIT=25
COLLECTOR_PLACEMENT_STRATEGY=runtime-host
COLLECTOR_AUTO_SCALE_ENABLED=false
# distributed-logical-hosts: Telegraf on each logical VM (host + DB metrics). Required when OBSERVABILITY_MODE=distributed-logical-hosts
LOGICAL_HOST_INFLUX_URL=http://<RUNTIME_HOST_IP>:8087
LOGICAL_HOST_SSH_USER=<REMOTE_VM_USER>
LOGICAL_HOST_SSH_KEY_PATH=/app/secrets/logical-host-ssh
LOGICAL_HOST_SSH_PORT=22
LOGICAL_HOST_CONFIG_DIR=/opt/oms/telegraf
# Windows logical hosts (ADR-012)
LOGICAL_HOST_WINRM_ENABLED=false
LOGICAL_HOST_WINRM_USER=
LOGICAL_HOST_WINRM_PASSWORD=
LOGICAL_HOST_WINRM_PORT=5985

# =============================================================================
# INFLUXDB LOCAL - Metrics Storage
# =============================================================================

DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=<CHANGE_ME>  # Generate: openssl rand -base64 24
DOCKER_INFLUXDB_INIT_ORG=client
DOCKER_INFLUXDB_INIT_BUCKET=metrics
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=<CHANGE_ME>  # Generate: openssl rand -base64 32

# =============================================================================
# LOKI - Central logs (Promtail envia logs de sistema)
# =============================================================================
# Cloud (api-proxy): http://<cloud-ip>:8443/loki/api/v1/push
# Central directo:  http://<central-ip>:3100/loki/api/v1/push
LOKI_URL=http://192.168.56.10:3100/loki/api/v1/push   # IP da VM Central (ou Cloud :8443)

# =============================================================================
# SOLACE - Message Broker Connection
# =============================================================================

SOLACE__HOST=192.168.56.30
SOLACE__PORT=1883
SOLACE__VPN=default
SOLACE__USERNAME=<CLIENT_NAME>-agent
SOLACE__PASSWORD=<CHANGE_ME>
METRICS_TOPIC_PREFIX=oms.metrics.frames
METRICS_ALLOWED_MEASUREMENTS=cpu,mem,disk,diskio,system,net,processes,postgresql,mysql,sqlserver,oracle

# Exposed HTTP ports (client layer)
CLIENT_INFLUXDB_HTTP_PORT=8087
CLIENT_DEMO_TRIGGERS_PORT=3101
CLIENT_ASSESSMENT_HTTP_PORT=3002
# Customer-agent API (127.0.0.1 no host — vault-ops, E2E, curl diagnóstico)
LOCAL_RUNTIME_API_PORT=5808

# =============================================================================
# CUSTOMER AGENT / ASSESSMENT
# =============================================================================

ASPNETCORE_ENVIRONMENT=Production
# Registry público (pull sem login): ghcr.io/amsv-dev — em par com repo GitHub amsv-dev/OMS-Client
# Override para testes: omsv2client.azurecr.io (requer docker login)
CLIENT_IMAGE_REGISTRY=ghcr.io/amsv-dev
OMS_IMAGE_TAG=latest
LOGICAL_COLLECTOR_CONF_DIR=/app/telegraf-dynamic

# =============================================================================
# VAULT - HashiCorp Vault OSS (arquitectura definitiva)
# =============================================================================
# Endereco interno (rede client-network). Nao expor ao host.
VAULT_ADDR=http://oms-vault:8200
# Arquitectura definitiva: o credential store e SEMPRE o Vault. Nao ha modos
# alternativos. O customer-agent garante auto-unseal via DPAPI (Windows) ou
# kernel keyring (Linux) e expoe estado via GET /local/credentials/state.
